# Copia este archivo como server/.env y completa los valores. NO subas .env a Git.

# Pexels (gratis, sin tarjeta): https://www.pexels.com/api/
PEXELS_API_KEY=

# Nominatim exige identificar tu aplicación (nombre + contacto)
NOMINATIM_USER_AGENT=MotoRutaWeb/1.0 (proyecto academico; tu-correo@ejemplo.com)

# Opcionales
PORT=3000
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX=20
SEARCH_RADIUS_METERS=3000
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSRM_URL=https://router.project-osrm.org
